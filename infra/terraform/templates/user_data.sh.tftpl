#!/bin/bash
set -euo pipefail

exec > >(tee -a /var/log/excalidash-bootstrap.log) 2>&1

APP_DIR=/opt/excalidash
REPO_URL='${repo_url}'
REPO_REF='${repo_ref}'
HOSTNAME='${app_hostname}'

SWAP_FILE=/swapfile
if ! swapon --show=NAME --noheadings | grep -qx "$SWAP_FILE"; then
  fallocate -l 2G "$SWAP_FILE"
  chmod 600 "$SWAP_FILE"
  mkswap "$SWAP_FILE" >/dev/null
  swapon "$SWAP_FILE"
fi
grep -q "^$SWAP_FILE" /etc/fstab || printf '%s none swap sw 0 0\n' "$SWAP_FILE" >>/etc/fstab

dnf install -y --setopt=install_weak_deps=False git

if [ ! -d "$APP_DIR/.git" ]; then
  git clone --branch "$REPO_REF" "$REPO_URL" "$APP_DIR"
else
  git -C "$APP_DIR" fetch origin "$REPO_REF"
  git -C "$APP_DIR" reset --hard FETCH_HEAD
fi

EXCALIDASH_HOSTNAME="$HOSTNAME" \
  EXCALIDASH_REPO_URL="$REPO_URL" \
  EXCALIDASH_REPO_REF="$REPO_REF" \
  bash "$APP_DIR/infra/ec2/bootstrap.sh"
